*.json linguist-language=JSON linguist-detectable=true

# Force .sql files to be detected as SQL language
*.sql linguist-language=SQL

# Custom language label for MongoDB shell scripts
# Note: "MongoDB" is not an official Linguist language. 
# GitHub will display the label "MongoDB", but syntax highlighting 
# may default to JavaScript or plain text.
*.mongo.js linguist-language=MongoDB

# Optional: If you want proper syntax highlighting while keeping 
# the custom label, you can also add:
# *.mongo.js linguist-detectable=true
